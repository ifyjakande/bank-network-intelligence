<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>1000000000</max_memory_usage>
            <!-- inserts through Distributed tables wait for the shard: no local spool to lose -->
            <distributed_foreground_insert>1</distributed_foreground_insert>
            <insert_quorum>0</insert_quorum>
        </default>
        <readonly>
            <!-- 2: no writes, but clients (the grafana plugin) may still set query settings,
                 within the bounds below -->
            <readonly>2</readonly>
            <max_memory_usage>800000000</max_memory_usage>
            <max_execution_time>30</max_execution_time>
            <max_result_rows>1000000</max_result_rows>
            <!-- a burst of heavy dashboard queries must not starve ingestion -->
            <max_memory_usage_for_user>1200000000</max_memory_usage_for_user>
            <max_concurrent_queries_for_user>20</max_concurrent_queries_for_user>
            <constraints>
                <max_memory_usage><max>800000000</max></max_memory_usage>
                <max_execution_time><max>30</max></max_execution_time>
                <max_result_rows><max>1000000</max></max_result_rows>
                <readonly><min>2</min></readonly>
                <max_memory_usage_for_user><max>1200000000</max></max_memory_usage_for_user>
                <max_concurrent_queries_for_user><max>20</max></max_concurrent_queries_for_user>
            </constraints>
        </readonly>
    </profiles>

    <users>
        <!-- the image's default user is disabled; every client gets its own account -->
        <default remove="1"/>

        <admin>
            <password_sha256_hex from_env="CH_ADMIN_PASSWORD_SHA256"/>
            <profile>default</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
        </admin>

        <etl>
            <password_sha256_hex from_env="CH_ETL_PASSWORD_SHA256"/>
            <profile>default</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT, INSERT ON netflow.*</query>
                <query>GRANT dictGet ON netflow.*</query>
                <query>GRANT SELECT, INSERT ON ops.*</query>
                <query>GRANT SYSTEM SYNC REPLICA ON netflow.*</query>
                <query>GRANT SELECT ON system.replicas</query>
            </grants>
        </etl>

        <grafana>
            <password_sha256_hex from_env="CH_GRAFANA_PASSWORD_SHA256"/>
            <profile>readonly</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <!-- data plus the admin-owned health views. Those views fan out with
                     cluster()/clusterAllReplicas(), whose remote legs run as this user, so it
                     reads replica and part metadata too. No REMOTE, no query_log, no other
                     system tables. -->
                <query>GRANT SELECT ON netflow.*</query>
                <query>GRANT SELECT ON ops.*</query>
                <query>GRANT dictGet ON netflow.*</query>
                <query>GRANT SELECT ON system.replicas</query>
                <query>GRANT SELECT ON system.parts</query>
            </grants>
        </grafana>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
