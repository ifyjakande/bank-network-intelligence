<clickhouse>
    <listen_host>0.0.0.0</listen_host>
    <logger>
        <level>information</level>
        <console>1</console>
    </logger>

    <!-- sized for four servers sharing one small box; raise these on real hardware -->
    <max_server_memory_usage_to_ram_ratio>0.9</max_server_memory_usage_to_ram_ratio>
    <max_server_memory_usage from_env="CH_MAX_SERVER_MEMORY"/>
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <background_pool_size>4</background_pool_size>
    <!-- 4 threads, 28 task slots: ALTERs that change a table's projections validate against
         the built-in reserves (up to 25 free slots, not the values below) and refuse to run on
         fewer. Slots are queue space, not threads, so memory stays bounded by the 4 threads -->
    <background_merges_mutations_concurrency_ratio>7</background_merges_mutations_concurrency_ratio>
    <background_schedule_pool_size>32</background_schedule_pool_size>
    <max_concurrent_queries>100</max_concurrent_queries>
    <!-- lower than the defaults, so mutations and big merges still run while merges are busy -->
    <merge_tree>
        <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>

    <!-- kafka engine: fixed consumer identity per node -->
    <kafka>
        <client_id from_env="CH_REPLICA"/>
        <auto_offset_reset>earliest</auto_offset_reset>
    </kafka>

    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>

    <query_log>
        <database>system</database>
        <table>query_log</table>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <database>system</database>
        <table>part_log</table>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
</clickhouse>
