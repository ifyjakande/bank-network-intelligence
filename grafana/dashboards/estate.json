          "rawSql": "SELECT sum(quality_sum) / sum(sessions) FROM netflow.quality_1m\n            WHERE minute >= toStartOfMinute(now()) - INTERVAL 5 MINUTE AND minute < toStartOfMinute(now()) AND region IN (${region:singlequote}) AND dictGet('netflow.branch', 'primary_provider', branch_id) IN (${provider:singlequote})",
