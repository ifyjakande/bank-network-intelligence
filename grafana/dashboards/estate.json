    {
      "type": "timeseries",
      "title": "Degraded sessions by app criticality",
      "description": "Share of sessions scoring under 70, per minute.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT minute AS time, criticality,\n                   100 * sum(degraded) / sum(sessions) AS degraded_pct\n            FROM netflow.quality_1m\n            WHERE $__timeFilter(minute) AND minute < toStartOfMinute(now()) AND region IN (${region:singlequote}) AND dictGet('netflow.branch', 'primary_provider', branch_id) IN (${provider:singlequote})\n            GROUP BY time, criticality ORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.criticality}"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.* )?critical$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
