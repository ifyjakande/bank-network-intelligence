    {
      "type": "stat",
      "title": "Reachability (what ping says)",
      "description": "Branches in the selection with any traffic in the last 5 minutes.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "WITH expected AS (\n                SELECT branch_id FROM netflow.circuit_by_tunnel\n                WHERE role = 'primary' AND provider IN (${provider:singlequote})\n                  AND dictGet('netflow.branch', 'region', branch_id) IN (${region:singlequote}))\n            SELECT 100 * (SELECT uniqExact(branch_id) FROM netflow.quality_1m\n                          WHERE minute >= toStartOfMinute(now()) - INTERVAL 5 MINUTE AND minute < toStartOfMinute(now()) AND branch_id IN (SELECT branch_id FROM expected))\n                       / (SELECT count() FROM expected)",
          "format": 1,
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#d03b3b"
              },
              {
                "value": 99,
                "color": "#0ca30c"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "\u2013",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Estate quality score",
      "description": "Mean 0-100 session score against each app's SLA targets, last 5 minutes.",
      "datasource": {
