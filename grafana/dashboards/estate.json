    {
      "type": "state-timeline",
      "title": "Worst branches \u00b7 quality per minute",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT q.minute AS time, r.label AS branch,\n                       round(sum(q.quality_sum) / sum(q.sessions)) AS quality\n                FROM netflow.quality_1m AS q\n                GLOBAL INNER JOIN (\n                    SELECT branch_id,\n                           concat(leftPad(toString(row_number() OVER (\n                                      ORDER BY sum(degraded) / sum(sessions) DESC)), 2, '0'),\n                                  ' \u00b7 ', branch_id) AS label\n                    FROM netflow.quality_1m\n                    WHERE $__timeFilter(minute) AND minute < toStartOfMinute(now())\n                      AND region IN (${region:singlequote}) AND dictGet('netflow.branch', 'primary_provider', branch_id) IN (${provider:singlequote})\n                    GROUP BY branch_id HAVING sum(sessions) >= 10\n                    ORDER BY sum(degraded) / sum(sessions) DESC LIMIT 10\n                ) AS r ON r.branch_id = q.branch_id\n                WHERE $__timeFilter(q.minute) AND q.minute < toStartOfMinute(now())\n                GROUP BY time, branch ORDER BY time, branch",
          "format": 0,
          "queryType": "timeseries"
        }
      ],
