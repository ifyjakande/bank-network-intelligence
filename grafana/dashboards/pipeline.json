    {
      "type": "stat",
      "title": "Ingest rate",
      "description": "Half-flow records written per second, last minute.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT count() / 60 FROM netflow.stitch_queue\n            WHERE ingested_at >= now() - INTERVAL 60 SECOND",
          "format": 1,
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#8e8e8a"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "\u2013",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Stitch lag",
      "description": "Oldest shard watermark behind now; empty until both shards have stitched. 10-20 s is the safety margin.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 4,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT if(count() < 2, NULL, dateDiff('second', min(w), now())) FROM (\n                SELECT argMax(watermark, updated_at) AS w FROM ops.etl_watermarks\n                WHERE job = 'stitch' GROUP BY shard)",
          "format": 1,
          "queryType": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#0ca30c"
              },
              {
                "value": 60,
                "color": "#fab219"
              },
              {
                "value": 300,
                "color": "#d03b3b"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "\u2013",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 3
    },
