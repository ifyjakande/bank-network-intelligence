#!/bin/bash
# First boot of the demo instance: Docker, the stack, and the Cloudflare Tunnel.
# Rendered by Terraform; everything it installs is pinned and verified.
set -euo pipefail
exec > >(tee -a /var/log/bni-bootstrap.log) 2>&1

REGION="${region}"
REPO="${git_repository}"
REF="${git_ref}"
APP=/opt/bni
PLUGINS=/usr/local/lib/docker/cli-plugins

dnf install -y docker git make openssl tar
systemctl enable --now docker

# compose and buildx plugins, pinned and checked against their published checksums
mkdir -p "$PLUGINS" /tmp/plugins && cd /tmp/plugins
curl -fsSLO "https://github.com/docker/compose/releases/download/v${compose_version}/docker-compose-linux-aarch64"
curl -fsSLO "https://github.com/docker/compose/releases/download/v${compose_version}/docker-compose-linux-aarch64.sha256"
sha256sum -c docker-compose-linux-aarch64.sha256
install -m 0755 docker-compose-linux-aarch64 "$PLUGINS/docker-compose"
curl -fsSLO "https://github.com/docker/buildx/releases/download/v${buildx_version}/buildx-v${buildx_version}.linux-arm64"
curl -fsSL "https://github.com/docker/buildx/releases/download/v${buildx_version}/checksums.txt" \
    | grep " \*\?buildx-v${buildx_version}.linux-arm64$" | sha256sum -c -
install -m 0755 "buildx-v${buildx_version}.linux-arm64" "$PLUGINS/docker-buildx"
docker compose version && docker buildx version

# cloudflared from Cloudflare's signed package repository
curl -fsSL https://pkg.cloudflare.com/cloudflared-ascii.repo -o /etc/yum.repos.d/cloudflared.repo
dnf install -y "cloudflared-${cloudflared_version}"

# read-only deploy key from SSM; git goes over ssh.github.com:443 because the security
# group only allows 443 out. Host keys come from GitHub's API over TLS, not first use.
install -d -m 700 /root/.ssh
aws ssm get-parameter --region "$REGION" --name "${deploy_key_param}" \
    --with-decryption --query Parameter.Value --output text > /root/.ssh/bni_deploy
chmod 600 /root/.ssh/bni_deploy
curl -fsSL https://api.github.com/meta \
    | python3 -c 'import json,sys; [print("[ssh.github.com]:443", k) for k in json.load(sys.stdin)["ssh_keys"]]' \
    > /root/.ssh/known_hosts
cat > /root/.ssh/config <<'SSH'
Host github.com
    HostName ssh.github.com
    Port 443
    User git
    IdentityFile /root/.ssh/bni_deploy
    IdentitiesOnly yes
    StrictHostKeyChecking yes
SSH
chmod 600 /root/.ssh/config

# the stack, at the pinned commit
git clone "$REPO" "$APP"
cd "$APP"
git checkout "$REF"
./scripts/gen-secrets.sh
chmod 600 .env.stack
echo "GRAFANA_ROOT_URL=${grafana_root_url}" >> .env.stack
make up

# publish Grafana through the tunnel; the token never touches user data or the logs
set +x
TOKEN="$(aws ssm get-parameter --region "$REGION" --name "${token_parameter}" \
    --with-decryption --query Parameter.Value --output text)"
cloudflared service install "$TOKEN"
unset TOKEN
systemctl enable --now cloudflared

touch "$APP/.bootstrap-done"
echo "bootstrap finished"
